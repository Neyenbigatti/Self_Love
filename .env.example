# Database — local SQLite by default.
# For Turso (production), uncomment and configure:
# TURSO_DB_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
TURSO_DB_URL=file:./data/selflove.db

# JWT secret — generate a random string (min 32 characters)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Resend (transactional email) — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=no-reply@selflove.com

# App
APP_URL=http://localhost:3000

# Feature flags
VERIFICATION_TOKEN_EXPIRY_HOURS=24
RESEND_COOLDOWN_SECONDS=60
